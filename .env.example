# Settings for `python -m dataops`. Real values (incl. secrets) live in ~/.config/ai-platform-dataops/env
# (created by deploy/db.sh init); environment variables override that file.
DATAOPS_BIND_HOST=127.0.0.1
DATAOPS_PORT=8096
DATAOPS_RUNTIME_DIR=./runtime
DATAOPS_DB_HOST=127.0.0.1
DATAOPS_DB_PORT=13306
DATAOPS_DB_NAME=public_dataops
DATAOPS_DB_USER=dataops_app
DATAOPS_DB_PASSWORD=
# OS_LJM = OncoStudio local OncoPACS on the Windows test PC (owner, 2026-10-28)
DATAOPS_LOCAL_SCP_HOST=10.101.1.107
DATAOPS_LOCAL_SCP_PORT=4001
DATAOPS_LOCAL_SCP_CALLED_AE=OS_LJM
DATAOPS_LOCAL_SCP_CALLING_AE=DATAOPS
# Remote hosts the local-host guard accepts besides this machine (space/comma separated, exact IPs)
DATAOPS_LOCAL_SCP_REVIEW_HOSTS=10.101.1.107
DATAOPS_BACKUP_ROOT=/mnt/ai-pipeline/backups
# Folders that may be analysed from the browser (':'-separated)
DATAOPS_INPUT_ROOTS=/mnt2/data/Public_dataset
# Analysis agent (headless Claude Code, read-only tools)
DATAOPS_AGENT_MODEL=claude-opus-5-5
DATAOPS_AGENT_BUDGET_USD=5
DATAOPS_AGENT_TIMEOUT_S=1800
# Central publication after approval. Target not decided (owner, 2026-10-28): leave unset/disabled.
DATAOPS_CENTRAL_HOST=
DATAOPS_CENTRAL_PORT=
DATAOPS_CENTRAL_CALLED_AE=
DATAOPS_CENTRAL_CALLING_AE=DATAOPS
DATAOPS_CENTRAL_ENABLED=false
